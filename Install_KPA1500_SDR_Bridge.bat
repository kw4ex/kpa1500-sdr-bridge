$log = Join-Path ([IO.Path]::GetTempPath()) 'kpa_install_log.txt'
try { Start-Transcript -Path $log -Force | Out-Null } catch { }

Clear-Host
Say '==========================================================' 'Cyan'
Say '   KPA1500 SDR Bridge - one-click installer' 'Cyan'
Say '==========================================================' 'Cyan'
Say ''
Say 'This sets up the bridge that connects an Elecraft KPA1500'
Say 'amplifier to Thetis or NereusSDR (and an LP-100A meter).'
Say 'It asks a few short questions. Press Enter to accept the'
Say 'answer shown in [brackets]. Nothing is changed until you'
Say 'confirm the install folder.'

# ---- unpack the files that travel inside this installer -------------------
$tmp = Join-Path ([IO.Path]::GetTempPath()) ('kpa_pkg_' + [guid]::NewGuid().ToString('N').Substring(0, 8))
New-Item -ItemType Directory -Path $tmp -Force | Out-Null
$all = [IO.File]::ReadAllText($env:KPA_INSTALLER)
$b0 = $all.IndexOf("`n#PAYLOAD-BEGIN")
$b1 = $all.IndexOf("`n#PAYLOAD-END")
if ($b0 -lt 0 -or $b1 -lt 0) { throw 'This installer file looks damaged (no payload). Please download it again.' }
$b64 = $all.Substring($b0 + 15, $b1 - $b0 - 15) -replace '\s', ''
$zip = Join-Path $tmp 'pkg.zip'
[IO.File]::WriteAllBytes($zip, [Convert]::FromBase64String($b64))
Add-Type -AssemblyName System.IO.Compression.FileSystem
$pk = Join-Path $tmp 'files'
[IO.Compression.ZipFile]::ExtractToDirectory($zip, $pk)
$newPy = Join-Path $pk 'kpa1500_sdr_bridge.py'
$newVer = ([regex]::Match([IO.File]::ReadAllText($newPy), '(?m)^VERSION = "([\d.]+)"')).Groups[1].Value
Say ("This installer contains bridge version $newVer.") 'Gray'

# ---- 1. Python ---------------------------------------------------------------
Head 'Step 1 of 8: Python'
$py = Find-Python
if (-not $py) {
    Say 'Python 3.8 or newer was not found on this computer. The bridge needs it.' 'Yellow'
    $winget = Get-Command winget -ErrorAction SilentlyContinue
    if ($winget -and $script:IsWin -and -not $script:Test) {
        if (AskYN 'Install Python now with Windows (winget)? About 100 MB.' $true) {
            try {
                & winget install -e --id Python.Python.3.12 --accept-package-agreements --accept-source-agreements
                $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User')
                $py = Find-Python
            } catch { Say "The automatic install did not finish: $($_.Exception.Message)" 'Yellow' }
        }
    }
    if (-not $py) {
        Say ''
        Say 'Please install Python yourself, then run this installer again:' 'Yellow'
        Say '  1. Go to https://www.python.org/downloads/ and download Python 3.'
        Say '  2. Run it and TICK "Add python.exe to PATH" on the first screen.'
        Say '  3. Double-click this installer again.'
        if (-not $script:Test -and $script:IsWin) { if (AskYN 'Open the download page now?' $true) { Start-Process 'https://www.python.org/downloads/' } }
        Pause-Key
        try { Stop-Transcript | Out-Null } catch { }
        exit 2
    }
}
$script:PyCmd = $py.cmd
Say ("Found $($py.ver)  (command: $($py.cmd))") 'Green'

# pyserial: the serial-port helper used for the LP-100A meter (installed now so it is ready)
$chk = Invoke-Py @('-c', 'import serial;print(serial.__version__)')
if ($chk -match '(?m)^\s*(\d+\.\d+\S*)\s*$') { Say ("pyserial $($Matches[1]) is already installed.") 'Green' }
elseif ($script:Test -and $env:KPA_TEST_NOPIP) { Say '(test mode: pyserial install skipped)' }
else {
    Say 'Installing pyserial (small serial-port helper for the LP-100A, needs internet)...'
    $o = Invoke-Py @('-m', 'pip', 'install', '--user', '--quiet', '--disable-pip-version-check', 'pyserial')
    $chk = Invoke-Py @('-c', 'import serial;print(serial.__version__)')
    if ($chk -notmatch '(?m)^\s*\d+\.\d+\S*\s*$') {   # some Python setups refuse --user: try the normal way
        $o = Invoke-Py @('-m', 'pip', 'install', '--quiet', '--disable-pip-version-check', 'pyserial')
        $chk = Invoke-Py @('-c', 'import serial;print(serial.__version__)')
    }
    if ($chk -match '(?m)^\s*(\d+\.\d+\S*)\s*$') { Say ("pyserial $($Matches[1]) installed.") 'Green' }
    else {
        Say 'pyserial could not be installed (no internet, or pip is missing).' 'Yellow'
        Say 'The bridge still works; only the LP-100A needs it. Later run:  py -m pip install pyserial' 'Yellow'
        $last = @($o -split "`r?`n" | Where-Object { $_.Trim() } | Select-Object -Last 2)
        foreach ($l in $last) { Say ('  ' + $l.Trim()) }
    }
}

# ---- 2. Where to install ------------------------------------------------------
Head 'Step 2 of 8: Install folder'
$SUB = 'KPA1500_SDR_Bridge'
$def = 'C:\RadioScripts'
if ($env:KPA_TEST_DIR) { $def = $env:KPA_TEST_DIR }
Say 'Choose the folder for your radio programs. The bridge gets its OWN subfolder in it,'
Say "named $SUB, so its files never mix with your other programs."
Say 'Do not use "Program Files" (Windows blocks the log and settings there).'
$dir = ''; $base = ''
while (-not $dir) {
    $d = AskText 'Folder' $def
    $d = $d.Trim('"').TrimEnd('\')
    if ($d -match '(?i)\\Program Files') { Say 'Please choose another folder (not Program Files).' 'Yellow'; continue }
    if ((Split-Path $d -Leaf) -ieq $SUB) { $b = Split-Path $d -Parent; $sd = $d } else { $b = $d; $sd = Join-Path $d $SUB }
    if (-not (Test-Path $b)) {
        if (-not (AskYN "The folder $b does not exist. Create it?" $true)) { continue }
        try { New-Item -ItemType Directory -Path $b -Force | Out-Null } catch { Say "Could not create it: $($_.Exception.Message)" 'Yellow'; continue }
    }
    try {
        if (-not (Test-Path $sd)) { New-Item -ItemType Directory -Path $sd -Force | Out-Null }
        $t = Join-Path $sd '.write_test'; [IO.File]::WriteAllText($t, 'x'); Remove-Item $t -Force
    } catch { Say 'That folder is not writable. Choose another.' 'Yellow'; continue }
    $dir = $sd; $base = $b
}
Say "The bridge goes into:  $dir" 'Green'
$script:WasRunning = Stop-OldBridge

# an older install directly in the chosen folder: move ITS files into the subfolder
$BRIDGE_FILES = @('kpa1500_sdr_bridge.py', 'kpa1500_thetis_setup.py', 'KPA1500_Bridge_Help.html', 'start_kpa_sdr_bridge.bat',
    'Setup_Thetis_Containers.bat', 'Undo_Thetis_Containers.bat', 'Uninstall_KPA1500_SDR_Bridge.bat', 'kpa1500_settings.json',
    'kpa1500_bridge.log', 'kpa1500_mac.txt', 'install_log.txt', 'install_selftest.txt',
    'KPA_Network_Check.bat', 'kpa_netcheck.ps1', 'kpa_network_check.txt', 'Open_Applet.bat', 'Stop_Bridge.bat')
if ($base -ne $dir -and (Test-Path (Join-Path $base 'kpa1500_sdr_bridge.py'))) {
    Say ''
    Say "An older install of the bridge is directly in $base." 'Yellow'
    Say "Its files (program, settings, log, Thetis backups) are MOVED into $SUB."
    Say "Nothing else in $base is touched."
    if (AskYN 'Move them now?' $true) {
        $moved = 0
        $items = @()
        foreach ($f in $BRIDGE_FILES) { $items += Join-Path $base $f }
        $items += @(Get-ChildItem -Path $base -Filter 'kpa1500_sdr_bridge.py.*.bak' -File -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName })
        $items += @(Get-ChildItem -Path $base -Filter 'start_kpa_sdr_bridge.bat.*.bak' -File -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName })
        foreach ($src in $items) {
            if (-not (Test-Path -LiteralPath $src)) { continue }
            $dst = Join-Path $dir (Split-Path $src -Leaf)
            try {
                if (Test-Path -LiteralPath $dst) { Remove-Item -LiteralPath $dst -Force }
                Move-Item -LiteralPath $src -Destination $dst -Force; $moved++
            } catch { Say ("  could not move " + (Split-Path $src -Leaf) + ": " + $_.Exception.Message) 'Yellow' }
        }
        $tb = Join-Path $base 'thetis_backups'
        if (Test-Path $tb) {
            $tbn = Join-Path $dir 'thetis_backups'
            if (-not (Test-Path $tbn)) { New-Item -ItemType Directory -Path $tbn -Force | Out-Null }
            foreach ($x in @(Get-ChildItem -Path $tb -File -ErrorAction SilentlyContinue)) {
                try { Move-Item -LiteralPath $x.FullName -Destination (Join-Path $tbn $x.Name) -Force; $moved++ } catch { }
            }
            try { if (-not (Get-ChildItem -Path $tb -Force -ErrorAction SilentlyContinue)) { Remove-Item -LiteralPath $tb -Force } } catch { }
        }
        Say "Moved $moved file(s) into $dir" 'Green'
    } else {
        Say "OK - the old files stay in $base. The new install in $dir starts fresh." 'Yellow'
    }
}
$destPy = Join-Path $dir 'kpa1500_sdr_bridge.py'
$launcher = Join-Path $dir 'start_kpa_sdr_bridge.bat'
$settingsFile = Join-Path $dir 'kpa1500_settings.json'
$oldBat = $null; $keep = $false
if (Test-Path $destPy) {
    $oldVer = ([regex]::Match([IO.File]::ReadAllText($destPy), '(?m)^VERSION = "([\d.]+)"')).Groups[1].Value
    Say ("An earlier install (version $oldVer) is in this folder. It will be upgraded to $newVer.") 'Yellow'
    Say 'Your settings and log files are kept. The old program is saved as a .bak copy.'
    if (-not (AskYN 'Continue?' $true)) { Say 'Cancelled. Nothing was changed.'; Pause-Key; exit 0 }
    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    Copy-Item $destPy ($destPy + '.' + $stamp + '.bak') -Force
    if (Test-Path $launcher) {
        $oldBat = [IO.File]::ReadAllText($launcher)
        Copy-Item $launcher ($launcher + '.' + $stamp + '.bak') -Force
        $of = Get-Old $oldBat 'BRIDGE_FLAGS'
        Say ("Your current start options are:  $of")
        $keep = AskYN 'Keep your current start options and Thetis choices (skips the questions below)?' $true
    }
}
Copy-Item $newPy $destPy -Force
Copy-Item (Join-Path $pk 'KPA1500_Bridge_Help.html') (Join-Path $dir 'KPA1500_Bridge_Help.html') -Force
foreach ($f in @('KPA_Network_Check.bat', 'kpa_netcheck.ps1', 'Open_Applet.bat', 'Stop_Bridge.bat', 'Uninstall_KPA1500_SDR_Bridge.bat')) { if (Test-Path (Join-Path $pk $f)) { Copy-Item (Join-Path $pk $f) (Join-Path $dir $f) -Force } }
# Thetis container (meters and buttons) setup tool and its two double-click files
$setupPy = Join-Path $dir 'kpa1500_thetis_setup.py'
Copy-Item (Join-Path $pk 'kpa1500_thetis_setup.py') $setupPy -Force
foreach ($nm in @('Setup_Thetis_Containers', 'Undo_Thetis_Containers')) {
    $bt = [IO.File]::ReadAllText((Join-Path $pk ($nm + '.template.bat'))).Replace('@@PYCMD@@', $script:PyCmd)
    [IO.File]::WriteAllText((Join-Path $dir ($nm + '.bat')), $bt)
}
Say "Program files copied to $dir" 'Green'

# ---- answers (defaults) -----------------------------------------------------
$flags = @()
$thetisLocal = $true; $thetisIp = ''
$useMmio = $true
$radioChoice = '3'
$hasLp = $null            # LP-100A: $true / $false / $null (not asked)
$startThetis = '0'; $thetisExe = 'C:\Program Files\OpenHPSDR\Thetis\Thetis.exe'; $thetisFlags = ''

if ($keep) {
    $flags = @((Get-Old $oldBat 'BRIDGE_FLAGS'))
    $startThetis = Get-Old $oldBat 'START_THETIS'
    $te = Get-Old $oldBat 'THETIS_EXE'; if ($te) { $thetisExe = $te }
    $tf = Get-Old $oldBat 'THETIS_FLAGS'; if ($tf) { $thetisFlags = $tf }
    $fj = ($flags -join ' ')
    $useMmio = ($fj -match '--mmio-port')
    $thetisLocal = -not ($fj -match '--mmio-host|--tci-host')
    if (($flags -join ' ') -notmatch '--applet') { $flags += '--applet' }
    Say 'Keeping your earlier options.' 'Green'
    $radioChoice = Ask-Radio 'Radio program (asked again, so you can change it)'
    if ($radioChoice -eq '2') { $useMmio = $false; Say 'NereusSDR only: no Thetis windows will be set up (Step 8 is skipped).' 'Green' }
    $pm = [regex]::Match(($flags -join ' '), '--web-token\s+(\S+)')
    if ($pm.Success) {
        Say ("The panel has a password: " + $pm.Groups[1].Value + "  (other devices only; remove or change it in the") 'Yellow'
        Say ' panel on this computer: Settings > Panel access)' 'Yellow'
    }
}
else {
    $flags += '--applet'
    # ---- 3. Amplifier network ---------------------------------------------------
    Head 'Step 3 of 8: Finding the amplifier'
    $nets = Get-LocalNets
    if ($nets.Count -gt 0) {
        Say 'This computer is on:'
        foreach ($n in $nets) { Say ("  {0}   {1}/{2}{3}" -f $n.Name, $n.IP, $n.Prefix, $(if ($n.Gw) { '   <- your main network' } else { '' })) }
    } else {
        Say ('Could not list this computer''s networks' + $(if ($script:NetErr) { ': ' + $script:NetErr } else { '.' })) 'Yellow'
    }
    Say ''
    Say 'The KPA1500 must be switched on (not asleep) and cabled to your router.'
    $mainNet = $null
    foreach ($n in $nets) { if ($n.Gw -and -not $mainNet) { $mainNet = $n } }
    $ampIp = ''; $wolBc = ''
    for ($try = 0; $try -lt 5 -and -not $ampIp; $try++) {
        Say ''
        if ($try -eq 0) { Say 'How should the installer find the amplifier?' } else { Say 'What would you like to do now?' }
        Say '  1  Search my network for it automatically (recommended)'
        Say '  2  I will type its IP address (amp: NET menu, or your router''s list of devices)'
        Say '  3  Skip for now - set it later in the browser panel (Settings > Amplifier)'
        $ch = AskText 'Type 1, 2 or 3 and press Enter' '1'
        if ($ch -eq '3') { break }
        if ($ch -eq '1') {
            $a = @($destPy, '--discover')
            if ($try -gt 0 -and $script:LastSearchFailed) {
                $rng = AskText 'Network to search, e.g. 192.168.1.0/24 (Enter = this computer''s networks again)' ''
                if ($rng) { $a = @($destPy, '--discover', $rng) }
            }
            Say 'Searching - about 5 seconds...'
            $out = Invoke-Py $a          # (never pass an empty value: Windows PowerShell 5.1 drops it)
            $m = [regex]::Match($out, 'Use it with:\s+--amp-ip\s+(\d+\.\d+\.\d+\.\d+)')
            if ($m.Success) {
                foreach ($l in @($out -split "`r?`n" | Where-Object { $_ -match 'Found:|Searching' })) { Say ('  ' + $l.Trim()) }
                if (AskYN ("Use the amplifier at " + $m.Groups[1].Value + "?") $true) { $ampIp = $m.Groups[1].Value }
                $script:LastSearchFailed = $false
            } else {
                $script:LastSearchFailed = $true
                foreach ($l in @($out -split "`r?`n" | Where-Object { $_ -match 'Searching|error|Cannot|Traceback' })) { Say ('  ' + $l.Trim()) 'Gray' }
                Say 'No KPA1500 answered. Is it switched on (not asleep) and cabled to the router?' 'Yellow'
                Say 'If it is on a different network, choose 1 again and type that network, or choose 2.' 'Yellow'
            }
        } elseif ($ch -eq '2') {
            $ip = AskText 'Amplifier IP address (like 192.168.0.175)' ''
            if (-not (Is-IPv4 $ip)) { Say 'That is not a valid IPv4 address (like 192.168.1.50).' 'Yellow'; continue }
            Say 'Checking...'
            $out = Invoke-Py @($destPy, '--probe', $ip)
            if ($script:PyExit -eq 0) { Say "A KPA1500 answered at $ip." 'Green'; $ampIp = $ip }
            else {
                foreach ($l in @($out -split "`r?`n" | Where-Object { $_ -match 'error|Cannot|Traceback' })) { Say ('  ' + $l.Trim()) 'Gray' }
                Say "No answer from $ip. That is normal if the amp is switched off or asleep." 'Yellow'
                Say 'Otherwise check the address and the cable (and, for another network, that your router passes UDP port 1500).'
                if (AskYN 'Use this address anyway?' $true) { $ampIp = $ip }
            }
        } else { Say 'Please type 1, 2 or 3.' 'Yellow' }
    }
    if ($ampIp) {
        Set-Setting $settingsFile 'amp_ip' $ampIp
        Say "Saved amplifier address $ampIp (you can change it later in the browser panel)." 'Green'
        $diff = $true
        foreach ($n in $nets) { if (Same-Subnet $ampIp $n.IP $n.Prefix) { $diff = $false } }
        if ($nets.Count -gt 0 -and $diff) {
            Say ''
            Say 'The amplifier is on a DIFFERENT subnet from this computer.' 'Yellow'
            Say '  - Normal control works if your router routes UDP port 1500 between the networks.'
            Say '  - "Search the network" only looks on one subnet at a time: type the amp''s network, e.g. 10.1.2.0/24.'
            Say '  - Remote Power ON (Wake-on-LAN) needs the router to forward a broadcast to the amp''s subnet.'
            $wolBc = AskText 'Wake-on-LAN broadcast address for the amp''s subnet, e.g. 10.1.2.255 (Enter = skip)' ''
            if ($wolBc -and -not (Is-IPv4 $wolBc)) { Say 'Not a valid address - skipped.' 'Yellow'; $wolBc = '' }
            if ($wolBc) { $flags += "--wol-broadcast $wolBc" }
        }
    } else { Say 'No address saved: the bridge will use 192.168.0.175 until you change it in the panel.' 'Yellow' }

    # ---- 4. Thetis ------------------------------------------------------------------
    $radioChoice = Ask-Radio 'Step 4 of 8: Radio program'
    if ($radioChoice -eq '2') {
        $useMmio = $false
        Say 'No Thetis windows will be set up (Step 8 is skipped). The Applet window shows the amplifier.' 'Green'
    }
    if ($radioChoice -ne '2') {
    $thetisLocal = AskYN 'Is Thetis running on THIS computer?' $true
    if (-not $thetisLocal) {
        $thetisIp = AskText 'IP address of the computer running Thetis' ''
        if (-not (Is-IPv4 $thetisIp)) { Say 'Not a valid address - assuming this computer.' 'Yellow'; $thetisLocal = $true; $thetisIp = '' }
        else {
            $flags += "--tci-host $thetisIp"
            Say 'In Thetis (Setup > Serial/Network/Midi CAT > Network > TCI Server) the TCI server must listen on its network address,' 'Yellow'
            Say 'not only 127.0.0.1, and Thetis''s firewall must allow the connection.' 'Yellow'
        }
    }
    $useMmio = AskYN 'Show amp readouts and use amp buttons inside a Thetis container (Multi Meter I/O)?' $true
    if ($useMmio) {
        $flags += '--mmio-port 50100 --mmio-format xml --mmio-listen 50101'
        if (-not $thetisLocal) {
            $flags += "--mmio-host $thetisIp --mmio-listen-bind 0.0.0.0"
            Add-FwRule 'KPA1500 Bridge buttons UDP 50101' 'UDP' 50101
        }
        Say 'The Thetis meter and button windows are added in Step 8 (Thetis must be closed then).'
    }
    if ($thetisLocal) {
        $progs = @((Get-Programs) | Where-Object { $_.Exe })
        if ($progs.Count -eq 0) {
            $found = Find-Thetis
            if ($found) { $progs = @([pscustomobject]@{ Key = 'thetis'; Name = 'Thetis'; Db = ''; Exe = $found }) }
        }
        if ($progs.Count -gt 0) {
            Say 'Found on this computer:' 'Green'
            foreach ($p in $progs) { Say ('  ' + $p.Name + ':  ' + $p.Exe) 'Green' }
            Say 'The bridge works with each of them (one at a time). In each one the TCI server must be on:'
            Say '  Setup > Serial/Network/Midi CAT > Network: tick TCI Server Running, Bind 127.0.0.1:50001, Apply, OK.'
            if (AskYN 'Should the start file also launch one of them (after starting the bridge)?' $false) {
                $pick = Pick-One $progs 'Which one should the start file launch?'
                $startThetis = '1'; $thetisExe = $pick.Exe
                if ($pick.Key -eq 'hl2') { $thetisFlags = '-dbid:HL2' } else { $thetisFlags = '' }
                Say ('The start file will launch ' + $pick.Name + '.') 'Green'
            }
            else { $thetisExe = $progs[0].Exe }
        }
    }

    }   # end of the Thetis questions

    # ---- 5. LP-100A -----------------------------------------------------------------
    Head 'Step 5 of 8: LP-100A power meter (optional)'
    $hasLp = AskYN 'Do you have a Telepost LP-100A connected by USB?' $false
    if ($hasLp) {
        $chk = Invoke-Py @('-c', 'import serial;print(serial.__version__)')
        if ($chk -notmatch '(?m)^\s*\d+\.\d+\S*\s*$') {
            Say 'Installing the serial-port helper (pyserial)...'
            $o = Invoke-Py @('-m', 'pip', 'install', '--user', '--quiet', '--disable-pip-version-check', 'pyserial')
        }
        $chk = Invoke-Py @('-c', 'import serial;print(serial.__version__)')
        if ($chk -match '(?m)^\s*\d+\.\d+\S*\s*$') {
            Say 'pyserial is ready.' 'Green'
            $ports = @(); try { $ports = [IO.Ports.SerialPort]::GetPortNames() } catch { }
            if ($ports.Count -gt 0) { Say ('Serial ports on this computer: ' + ($ports -join ', ')) }
            $cp = AskText 'LP-100A COM port, e.g. COM5 (Enter = choose later in the panel)' ''
            if ($cp -match '^(?i)COM\d+$') { Set-Setting $settingsFile 'lp100_port' $cp.ToUpper(); Say "Saved $($cp.ToUpper())." 'Green' }
        } else {
            Say 'pyserial could not be installed (no internet?). Later, run:  py -m pip install pyserial' 'Yellow'
        }
    }

    # ---- 6. Browser panel on the network ----------------------------------------------
    Head 'Step 6 of 8: Browser control panel'
    Say 'The panel opens on this computer at http://127.0.0.1:8080.'
    if (AskYN 'Also allow other computers or phones on your network to open it?' $false) {
        Say 'A password stops others on your network from using the panel. This computer never needs it,'
        Say 'and it can be changed or removed later in the panel (Settings > Panel access) on this computer.'
        $tok = ''
        for ($k = 0; $k -lt 3; $k++) {
            $tok = AskText 'Panel password, 4-32 letters/digits (Enter = no password)' ''
            if (-not $tok -or $tok -match '^[A-Za-z0-9_-]{4,32}$') { break }
            Say 'Use 4 to 32 letters, digits, - or _ (no spaces).' 'Yellow'; $tok = ''
        }
        if ($tok) {
            $flags += "--web-bind 0.0.0.0 --web-token $tok"
            Say "Panel password: $tok   (phones/other PCs open http://THIS-PC:8080/?t=$tok)" 'Yellow'
        } else {
            $flags += '--web-bind 0.0.0.0'
            Say 'No password: anyone on your home network who opens the panel can use it.' 'Yellow'
        }
        Add-FwRule 'KPA1500 Bridge panel TCP 8080' 'TCP' 8080
    }
}

# ---- write the start file ------------------------------------------------------
$tpl = [IO.File]::ReadAllText((Join-Path $pk 'start_kpa_sdr_bridge.template.bat'))
$tpl = $tpl.Replace('@@BRIDGE_DIR@@', $dir).Replace('@@PYCMD@@', $script:PyCmd).Replace('@@BRIDGE_FLAGS@@', ($flags -join ' ').Trim())
$tpl = $tpl.Replace('@@START_THETIS@@', $startThetis).Replace('@@THETIS_EXE@@', $thetisExe).Replace('@@THETIS_FLAGS@@', $thetisFlags)
[IO.File]::WriteAllText($launcher, $tpl)
Say "Start file written: $launcher" 'Green'

# ---- 7. Shortcuts, firewall, test ------------------------------------------------
Head 'Step 7 of 8: Shortcuts and finishing'
if ($script:IsWin -and -not $script:Test) {
    $lnkD = Join-Path ([Environment]::GetFolderPath('Desktop')) 'KPA1500 SDR Bridge.lnk'
    $lnkS = Join-Path ([Environment]::GetFolderPath('Startup')) 'KPA1500 SDR Bridge.lnk'
    foreach ($l in @($lnkD, $lnkS)) {
        if (Test-Path -LiteralPath $l) {
            try { New-Shortcut $l $launcher $dir 'Start the KPA1500 SDR bridge'; $script:Made += $l; Say "Shortcut updated: $l" 'Green' } catch { }
        }
    }
    if ((Test-Path -LiteralPath $lnkD) -and ($script:Made -contains $lnkD)) { }
    elseif (AskYN 'Put a "KPA1500 SDR Bridge" shortcut on the Desktop?' $true) {
        try {
            $lnk = Join-Path ([Environment]::GetFolderPath('Desktop')) 'KPA1500 SDR Bridge.lnk'
            New-Shortcut $lnk $launcher $dir 'Start the KPA1500 SDR bridge'
            $script:Made += $lnk; Say 'Desktop shortcut created.' 'Green'
        } catch { Say "Could not create the shortcut: $($_.Exception.Message)" 'Yellow' }
    }
    if ((Test-Path -LiteralPath $lnkS) -and ($script:Made -contains $lnkS)) { }
    elseif (AskYN 'Start the bridge automatically when you sign in to Windows?' $false) {
        try {
            $lnk = Join-Path ([Environment]::GetFolderPath('Startup')) 'KPA1500 SDR Bridge.lnk'
            New-Shortcut $lnk $launcher $dir 'Start the KPA1500 SDR bridge at sign-in'
            $script:Made += $lnk; Say 'Auto-start set up. (To undo: delete that shortcut from the Startup folder.)' 'Green'
        } catch { Say "Could not create the auto-start shortcut: $($_.Exception.Message)" 'Yellow' }
    }
}
Apply-Firewall


if (AskYN 'Run a quick self-test of the program now (about two minutes, uses simulated hardware)?' $false) {
    Say 'Testing...'
    $o = Invoke-Py @($destPy, '--selftest')
    $tail = ($o -split "`r?`n" | Where-Object { $_.Trim() } | Select-Object -Last 1)
    [IO.File]::WriteAllText((Join-Path $dir 'install_selftest.txt'), $o)
    if ($o -match 'ALL TESTS PASSED') { Say $tail 'Green' }
    else {
        Say 'The self-test did not fully pass. The bridge may still work; details are in install_selftest.txt.' 'Yellow'
        $bad = @($o -split "`r?`n" | Where-Object { $_ -match 'FAIL\]|Traceback|Error' } | Select-Object -First 8)
        foreach ($l in $bad) { Say ('  ' + $l.Trim()) }
        Say 'Please send the file install_selftest.txt (in the install folder) to whoever gave you this installer.'
    }
}

# ---- 8. Thetis meter and button windows ------------------------------------------------
Head 'Step 8 of 8: meter and button windows inside Thetis'
Say 'The bridge can show its own windows INSIDE Thetis, Thetis HL2 or SDR-VST3:'
Say '  KPA1500 Telemetry - bars for power, SWR and drive, plus PA temp, volts, amps, fan, faults'
Say '  KPA1500 Controls  - lit buttons: OPERATE, ATU, ANT, AMP power, TUNE, SoT, FAULT, FAN'
Say '  KPA1500 Knob      - (optional) what a FlexControl tuning knob and its buttons do right now'
Say 'This step adds them to the program''s settings for you. A backup of those settings'
Say 'is saved first, and Undo_Thetis_Containers.bat puts it back at any time.'
$thetisDone = $false
if (-not $useMmio) {
    Say 'Skipped: you chose not to use the Thetis container (Multi Meter I/O) in Step 4.' 'Yellow'
    Say 'You can add the windows later by double-clicking Setup_Thetis_Containers.bat.'
}
elseif (-not $thetisLocal) {
    Say 'Thetis is on another computer, so the windows must be added THERE:' 'Yellow'
    Say '  copy kpa1500_thetis_setup.py and Setup_Thetis_Containers.bat from the install folder'
    Say '  to that computer (Python must be installed there too), close Thetis, double-click the .bat.'
    Say '  Then in Thetis Setup > Multi Meter I/O point the buttons entry at THIS computer, port 50101.'
}
elseif ($script:Test -and -not $env:KPA_TEST_DB -and -not $env:KPA_TEST_PROGRAMS) {
    Say '(test mode: Thetis step skipped)'
}
else {
    $sa = @($setupPy)
    $chosen = @()
    if ($env:KPA_TEST_DB) {
        $chosen = @([pscustomobject]@{ Key = 'thetis'; Name = 'Thetis'; Db = $env:KPA_TEST_DB; Exe = '' })
    } else {
        $have = @((Get-Programs) | Where-Object { $_.Db })
        if ($have.Count -eq 0) {
            Say ''
            Say 'No Thetis settings were found yet. Start Thetis (or Thetis HL2 / SDR-VST3) once, set up' 'Yellow'
            Say 'the radio, close it, then double-click Setup_Thetis_Containers.bat in the install folder.' 'Yellow'
        } elseif ($have.Count -eq 1) {
            if (AskYN ('Add the KPA1500 windows to ' + $have[0].Name + ' now?') $true) { $chosen = @($have[0]) }
        } else {
            Say ''
            Say 'These programs are on this computer:'
            if (AskYN 'Add the KPA1500 windows now?' $true) {
                $chosen = @(Pick-Many $have 'Which ones?')
            }
        }
    }
    if ($chosen.Count -eq 0) {
        Say 'OK. Later: close the program and double-click Setup_Thetis_Containers.bat in the install folder.'
    } else {
        $names = ($chosen | ForEach-Object { $_.Name }) -join ', '
        Say ('Setting up: ' + $names) 'Green'
        if ($hasLp -eq $true) { $sa += '--lp100' } elseif ($hasLp -eq $false) { $sa += '--no-lp100' }
        if ($env:KPA_TEST_DB) { $sa += @('--db', $env:KPA_TEST_DB, '--yes', '--skip-running-check') }
        else { $sa += @('--program', (($chosen | ForEach-Object { $_.Key }) -join ',')) }
        if ($env:KPA_TEST_PROGRAMS) { $sa += @('--yes', '--skip-running-check') }
        $sa += '--no-restart'          # the program is started at the very end, after the last question
        # is one of the chosen programs open? (told apart by folder: all of them run as Thetis.exe)
        $open = $null
        foreach ($rp in (Get-RunningThetis)) {
            foreach ($c in $chosen) {
                if ($rp -eq '?' -or ($c.Exe -and ((Split-Path $rp) -ieq (Split-Path $c.Exe)))) { $open = @($rp, $c); break }
            }
            if ($open) { break }
        }
        if ($env:KPA_TEST_THETIS) { $open = @('test', $chosen[0]) }
        if ($open) {
            if ($open[0] -ne '?' -and $open[0] -ne 'test') {
                $script:ThetisRestart = $open[0]; $script:ThetisRestartName = $open[1].Name
                if ($open[1].Key -eq 'hl2') { $script:ThetisRestartArgs = '-dbid:HL2' }
            }
            Say ''
            Say ($open[1].Name + ' is running. It must be closed for this step, because it saves its own settings') 'Yellow'
            Say 'when it closes and would overwrite the new windows.' 'Yellow'
            if (AskYN ('Close ' + $open[1].Name + ' for you now? It closes the normal way and saves its settings (like File > Exit). Make sure the radio is not transmitting.') $true) {
                $sa += '--close-thetis'
                Say 'It will be closed. You can start it again at the very end of the installer.'
            } else {
                Say 'OK - the setup will wait while you close it yourself (File > Exit).' 'Yellow'
            }
        }
        Say ''
        $ErrorActionPreference = 'Continue'
        $parts = @($script:PyCmd -split ' ')
        $pre = @(); if ($parts.Count -gt 1) { $pre = $parts[1..($parts.Count - 1)] }
        & $parts[0] @pre @sa
        $rc = $LASTEXITCODE
        $ErrorActionPreference = 'Stop'
        if ($rc -eq 0) { $thetisDone = $true; $doneNames = $names; Say ('KPA1500 windows are set up in: ' + $names) 'Green' }
        else { Say 'The windows were not added everywhere (see the messages above). Run Setup_Thetis_Containers.bat later.' 'Yellow' }
    }
}

try { Stop-Transcript | Out-Null; Copy-Item $log (Join-Path $dir 'install_log.txt') -Force } catch { }
try { Remove-Item $tmp -Recurse -Force } catch { }

Head 'All done'
Say "Installed in:   $dir" 'Green'
Say ("Start it with: " + $launcher + $(if ($script:Made.Count) { '   (or the Desktop shortcut)' } else { '' })) 'Green'
Say 'Browser panel: http://127.0.0.1:8080  (opens from the bridge window with key W for help)'
Say 'Applet window: Open_Applet.bat opens it any time (the start file opens it too). Stop_Bridge.bat closes the bridge.'
Say 'Help file:     KPA1500_Bridge_Help.html  (in the install folder)'
if ($thetisDone) {
    Say ('Windows added: ' + $doneNames + ' - start one and the KPA1500 windows appear.') 'Green'
    Say '               Move/resize them where you like; the program remembers. The bridge must be running.'
} else {
    Say 'Thetis:        double-click Setup_Thetis_Containers.bat (program closed) to add the windows.'
}
Say 'Undo:          Undo_Thetis_Containers.bat puts back the settings saved before the setup (it asks which program).'
Say 'Thetis help:   "The Thetis windows (meters and buttons)" section in the help file, with pictures.'
Say 'To remove: run Uninstall_KPA1500_SDR_Bridge.bat in the install folder.'
if ($radioChoice -ne '1') { Show-NereusSettings }
if ($script:IsWin -and -not $script:Test) {
    # all questions first, then start the programs: once a program opens it takes the focus
    Say ''
    if ($script:WasRunning) { Say 'The old bridge was closed for the update - start the new one now.' 'Yellow' }
    $goBridge = $false; $goThetis = $false
    if (Test-BridgeRunning) { Say 'A bridge is still running, so the new one cannot start yet: close it first (press Q in its window).' 'Yellow' }
    else { $goBridge = AskYN 'Start the bridge now?' $true }
    $thPath = $script:ThetisRestart
    if ($goBridge -and $startThetis -eq '1') { $thPath = $null }   # the start file launches the program itself
    $thOpen = $false
    try { $thOpen = [bool](Get-Process -Name Thetis -ErrorAction SilentlyContinue) } catch { }
    if ($thPath -and -not $thOpen -and (Test-Path -LiteralPath $thPath)) { $goThetis = AskYN ('Start ' + $script:ThetisRestartName + ' now?') $true }
    $goHelp = AskYN 'Open the help file now?' $false
    Say ''
    Say 'Starting what you chose. This window closes by itself in a minute.' 'Green'
    if ($goBridge) { Start-Process -FilePath $launcher -WorkingDirectory $dir; Start-Sleep -Seconds 2 }
    if ($goThetis) {
        if ($script:ThetisRestartArgs) { Start-Process -FilePath $thPath -WorkingDirectory (Split-Path $thPath) -ArgumentList $script:ThetisRestartArgs }
        else { Start-Process -FilePath $thPath -WorkingDirectory (Split-Path $thPath) }
    }
    if ($goHelp) { Start-Sleep -Seconds 1; Start-Process (Join-Path $dir 'KPA1500_Bridge_Help.html') }
}
